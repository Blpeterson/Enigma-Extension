{
  "manifest_version": 3,
  "name": "Drive Vault",
  "description": "Encrypt before Gmail and Calendar receive your text, and decrypt Drive Vault payloads locally.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://calendar.google.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html",
    "default_title": "Drive Vault"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://calendar.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
